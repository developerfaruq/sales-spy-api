* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Scribe writes these files; do not lint generated whitespace.
/.scribe/** linguist-generated=true -whitespace
/resources/views/scribe/** linguist-generated=true -whitespace
/public/vendor/scribe/** linguist-generated=true -whitespace
/storage/app/private/scribe/** linguist-generated=true -whitespace
