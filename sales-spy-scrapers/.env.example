SCRAPER_DATABASE_URL=postgresql://user:password@localhost:5432/sales_spy
SCRAPER_REDIS_URL=redis://localhost:6379/0
# Identify your crawler with a domain you actually control, and host a page
# there explaining the bot. Site owners use this to contact you.
SCRAPER_USER_AGENT=SalesSpyBot/1.0 (+https://your-domain.example/bot)
SCRAPER_LOG_LEVEL=INFO
SCRAPER_MAX_CONCURRENCY=10
SCRAPER_PER_HOST_CONCURRENCY=1
SCRAPER_REQUESTS_PER_SECOND=1.0
SCRAPER_CONNECT_TIMEOUT_SECONDS=5
SCRAPER_READ_TIMEOUT_SECONDS=15
SCRAPER_MAX_RESPONSE_BYTES=5242880
SCRAPER_MAX_REDIRECTS=5
SCRAPER_MAX_ATTEMPTS=3
SCRAPER_CLAIM_BATCH_SIZE=10
SCRAPER_CRAWL_MAX_ATTEMPTS=5
SCRAPER_CRAWL_RECOVERY_WINDOW_DAYS=7
SCRAPER_SUCCESS_RECRAWL_HOURS=168
SCRAPER_FAILED_RETRY_MINUTES=60
SCRAPER_STALE_CLAIM_MINUTES=30
SCRAPER_CRAWL_DEADLINE_SECONDS=600
SCRAPER_DATABASE_CONNECT_TIMEOUT_SECONDS=5
SCRAPER_DATABASE_STATEMENT_TIMEOUT_SECONDS=30
SCRAPER_DATABASE_CONCURRENCY=4
SCRAPER_DATABASE_POOL_MIN_SIZE=1
SCRAPER_DATABASE_POOL_MAX_SIZE=8
SCRAPER_ROBOTS_CACHE_SECONDS=3600
# Must match the newest migration the worker's queries depend on. The startup
# guard only proves this one is applied, so leaving it behind lets the worker
# boot against a schema it cannot actually query.
SCRAPER_SCHEMA_MIGRATION=2026_08_07_110000_add_lead_query_indexes
SCRAPER_SCAN_CLAIM_BATCH_SIZE=2
SCRAPER_SCAN_MAX_ATTEMPTS=3
SCRAPER_SCAN_RECOVERY_WINDOW_DAYS=7
SCRAPER_DEEP_SCAN_PAGE_LIMIT=100
SCRAPER_DEEP_SCAN_PRODUCT_LIMIT=25000
SCRAPER_COMMON_CRAWL_INDEX=CC-MAIN-2026-30
SCRAPER_COMMON_CRAWL_DEADLINE_SECONDS=120
SCRAPER_COMMON_CRAWL_MAX_RESPONSE_BYTES=20000000
